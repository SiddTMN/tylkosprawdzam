{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crypto calendar snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "publication",
    "generatedAt",
    "displayTimezone",
    "window",
    "sources",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "local-prototype",
        "automated-calendar"
      ]
    },
    "publication": {
      "type": "object",
      "required": [
        "approved"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "displayTimezone": {
      "const": "Europe/Warsaw"
    },
    "window": {
      "type": "object",
      "required": [
        "from",
        "toExclusive",
        "timezone"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "toExclusive": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "const": "Europe/Warsaw"
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "url",
          "status",
          "checkedAt",
          "verifiedAt"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "enum": [
              "fresh",
              "cached",
              "stale",
              "unavailable"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reuse": {
            "enum": [
              "review-required",
              "approved-by-repository-setting"
            ]
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "token",
          "date",
          "startsAt",
          "title",
          "description",
          "category",
          "priority",
          "sourceId",
          "sourceUrl",
          "verifiedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "token": {
            "type": "string",
            "pattern": "^[A-Z0-9]{1,12}$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "startsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endDate": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Inclusive publisher end day, when explicitly provided."
          },
          "endDateExclusive": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Exclusive boundary derived from the explicit inclusive end day."
          },
          "endsAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "sourceStartDate": { "type": "string", "format": "date" },
          "sourceEndDate": { "type": ["string", "null"], "format": "date" },
          "sourceStartTime": { "type": ["string", "null"] },
          "sourceEndTime": { "type": ["string", "null"] },
          "timingPrecision": { "enum": ["day", "instant"] },
          "publicationApproved": { "type": "boolean" },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "automated-calendar"
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "properties": {
              "approved": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
